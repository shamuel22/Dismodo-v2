# --- Database (docker compose exposes Postgres on 5434) ---
DATABASE_URL=postgres://dismodo:dismodo@localhost:5434/dismodo

# --- API ---
PORT=4100
HOST=0.0.0.0
# Public base URL used to build learner session links
PUBLIC_BASE_URL=http://localhost:4100

# --- Meta Model API (server only; never shipped to clients) ---
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# --- Decision models (adaptive route) ---
# Providers: meta | openai-compatible | anthropic | none. A tier without credentials is disabled;
# with no tier configured, sessions use the package's reviewed editorial route.
DECISION_ROUTINE_PROVIDER=meta
DECISION_ROUTINE_MODEL=muse-spark-1.3
DECISION_ROUTINE_EFFORT=minimal
DECISION_ROUTINE_TIMEOUT_MS=8000
DECISION_CRITICAL_PROVIDER=meta
DECISION_CRITICAL_MODEL=muse-wonder-1.0
DECISION_CRITICAL_EFFORT=minimal
DECISION_CRITICAL_TIMEOUT_MS=30000
# Other providers (optional)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
ANTHROPIC_API_KEY=
# Demonstrate fallbacks: none | timeout | error | invalid | refuse, on routine | critical | all
DECISION_FAULT=none
DECISION_FAULT_TIER=all
