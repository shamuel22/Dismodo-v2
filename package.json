{
  "name": "dismodo",
  "private": true,
  "version": "0.1.0",
  "description": "DISMODO — adaptive learning engine for builders and AI agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @dismodo/api dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:migrate": "pnpm --filter @dismodo/api db:migrate",
    "seed": "pnpm --filter @dismodo/api seed",
    "tenant:create": "pnpm --filter @dismodo/api tenant:create",
    "dismodo": "node packages/cli/bin/dismodo.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
