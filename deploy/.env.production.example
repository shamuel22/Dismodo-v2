# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public domain, no scheme (e.g. dismodo.example.com).
DISMODO_DOMAIN=dismodo.example.com

# Postgres (generate the password: openssl rand -hex 24).
POSTGRES_USER=dismodo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dismodo

# Meta Model API: enables the adaptive route (Muse Spark routine, Muse Wonder critical).
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
DECISION_ROUTINE_PROVIDER=meta
DECISION_ROUTINE_MODEL=muse-spark-1.3
DECISION_ROUTINE_EFFORT=minimal
DECISION_ROUTINE_TIMEOUT_MS=8000
DECISION_CRITICAL_PROVIDER=meta
DECISION_CRITICAL_MODEL=muse-wonder-1.0
DECISION_CRITICAL_EFFORT=minimal
DECISION_CRITICAL_TIMEOUT_MS=30000

# Optional: only with deploy/docker-compose.tunnel.yml.
CLOUDFLARE_TUNNEL_TOKEN=

LOG_LEVEL=info
