# DISMODO production reverse proxy.
# DISMODO_SITE_ADDRESS comes from the caddy service environment: the bare domain
# (Caddy obtains and renews the TLS certificate itself), or "http://<domain>"
# behind a Cloudflare Tunnel, where Cloudflare terminates TLS.

{
	servers {
		# Behind the tunnel the peer is cloudflared on a private network; trust it for the
		# visitor's address. Public peers (direct mode) are not trusted, so the header is ignored.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

{$DISMODO_SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# No global Content-Security-Policy and no X-Frame-Options /
	# frame-ancestors here, on purpose:
	#   - a strict CSP breaks the Vite SPA (inline bootstrap, fonts, WASM);
	#   - the embed script at /embed/dismodo-session.js must stay loadable
	#     cross-origin (<script type="module" src="https://.../embed/...">),
	#     and the <dismodo-session> element it defines is not an iframe, so
	#     framing policy must not be applied to it.
	# The API itself sends CORS "*" only on /v1/runtime/* and /embed/*
	# (see apps/api/src/server.ts); everything else stays same-origin.
	# If framing ever needs restricting, scope it to the HTML pages only,
	# e.g.:  @pages path / /s/* /docs/*
	#         header @pages Content-Security-Policy "frame-ancestors 'self'"

	handle /mcp {
		reverse_proxy mcp:4200
	}

	handle {
		# The API trusts exactly one proxy hop (TRUST_PROXY_HOPS=1) for per-IP rate limits.
		reverse_proxy api:4100 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	log {
		output stdout
		format console
	}
}
