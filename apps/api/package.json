{
  "name": "@dismodo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "tenant:create": "tsx --env-file-if-exists=../../.env scripts/create-tenant.ts",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "decisions:live": "tsx --env-file-if-exists=../../.env scripts/live-decisions.ts"
  },
  "dependencies": {
    "@dismodo/adaptation": "workspace:*",
    "@dismodo/contracts": "workspace:*",
    "@dismodo/engine": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dismodo/activities": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
